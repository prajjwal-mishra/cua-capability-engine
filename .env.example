# ---------------------------------------------------------------------------
# LLM provider for the DISCOVERY loop only. Replay never reads these.
# Any OpenAI-compatible endpoint works: Groq, OpenRouter, OmniRoute, Gemini's
# compat endpoint, or Anthropic behind a compat gateway.
#
#   Groq (free tier, recommended):
#     CUA_LLM_BASE_URL=https://api.groq.com/openai/v1
#     CUA_LLM_MODEL=moonshotai/kimi-k2-instruct
#
#   Local OmniRoute:
#     CUA_LLM_BASE_URL=http://localhost:20128/v1
#     CUA_LLM_MODEL=auto/coding
# ---------------------------------------------------------------------------
CUA_LLM_BASE_URL=https://api.groq.com/openai/v1
CUA_LLM_API_KEY=
CUA_LLM_MODEL=moonshotai/kimi-k2-instruct

# Target app ports
LEGACY_CU_PORT=4000
OPERATOR_PORT=4100

# Run the browser headed so an operator can take over the live session.
# HEADLESS=1 still supports takeover via the console's action-injection form.
HEADLESS=0
